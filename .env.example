# Database
DATABASE_URL="postgresql://postgres:your-db-password-here@localhost:5432/parental_sanity?schema=public"

# Redis (use redis://:PASSWORD@host:port format to enable AUTH)
REDIS_PASSWORD="your-redis-password-here"
REDIS_URL="redis://:your-redis-password-here@localhost:6379"

# NextAuth
NEXTAUTH_URL="https://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google Cloud OAuth app credentials (required for Gmail API access)
# This is your app's identity with Google, not a user credential.
# Create at: https://console.cloud.google.com/apis/credentials
# Must have Gmail API enabled. Users authorize their own inboxes via the setup wizard.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://localhost:3000/api/gmail/callback"

# AES-256-GCM key for encrypting secrets (Gmail tokens, API keys) at rest
# Generate with: openssl rand -hex 32   (must be 64 hex characters, NOT base64)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# AI provider, Resend, worker, and debug settings are configured via Admin > Settings
# and stored encrypted in the database. See app.config.defaults.ts for factory defaults.
