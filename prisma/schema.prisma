generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum SummaryStyle {
  CONCISE
  STANDARD
  DETAILED
}

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  USABILITY
  EMAIL_QUALITY
  GENERAL
}

enum AccountStatus {
  ACTIVE
  WARNING
  DEACTIVATED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  pendingEmail String?
  passwordHash String?
  name         String
  role         Role     @default(USER)
  emailVerified       DateTime?
  wizardStep          Int      @default(0)
  isMonitoringEnabled Boolean      @default(true)
  summaryStyle        SummaryStyle @default(CONCISE)
  forwardingMode      String       @default("INDIVIDUAL") // DEPRECATED — kept for rollback safety
  feedbackTrainingConsent String?  @default("granted")  // null = unasked, "granted" = opted in, "denied" = opted out
  supportDataConsent  Boolean  @default(false)
  supportDataConsentExpiresAt DateTime?
  debugToolsEnabled   Boolean  @default(false)
  digestDayOfWeek     Int          @default(1)    // DEPRECATED — kept for rollback safety
  digestTimeHour      Int          @default(8)    // DEPRECATED — kept for rollback safety
  timezone            String       @default("America/New_York")
  lastDigestSentAt    DateTime?    // DEPRECATED — kept for rollback safety

  // New delivery system: individual + briefs are independent toggles
  individualForwardingEnabled  Boolean  @default(true)
  dailyBriefEnabled            Boolean  @default(true)
  weeklyBriefEnabled           Boolean  @default(true)
  briefScope                   String   @default("ALL") // "ACTIONABLE" | "ALL"
  dailyBriefHour               Int      @default(6)    // 0-23, user's timezone
  weeklyBriefDay               Int      @default(0)    // 0=Sun, 5=Fri, 6=Sat
  weeklyBriefHour              Int      @default(9)    // 0-23
  lastDailyBriefSentAt         DateTime?
  lastWeeklyBriefSentAt        DateTime?
  calendarToken       String?  @unique
  defaultEventsView      String   @default("agenda")     // "agenda" | "month"
  actionableEventsOnly   Boolean  @default(false)
  showLinksInSummary     Boolean  @default(true)
  brutalMode             Boolean  @default(false)
  completedTours      String   @default("[]")         // JSON array: ["events","emails","settings"]
  emailAccountType    String   @default("DEDICATED") // "DEDICATED" | "SHARED"
  householdId         String?

  // Lifecycle / activity tracking
  accountStatus        AccountStatus @default(ACTIVE)
  lastActiveAt         DateTime?
  lastCalendarAccessAt DateTime?
  inactivityNotifiedAt DateTime?   // when the initial warning was sent (starts 14-day countdown)
  lifecycleEmailsSent  Int         @default(0) // 0=none, 1=14-day, 2=7-day, 3=1-day, 4=deactivated
  deactivatedAt        DateTime?
  reactivatedAt        DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Household
  household           Household?        @relation("HouseholdMember", fields: [householdId], references: [id])
  ownedHousehold      Household?        @relation("HouseholdPrimary")

  // App relations
  emailConnection     EmailConnection?
  parents             Parent[]
  children            Child[]
  forwardingAddresses ForwardingAddress[]
  processedEmails     ProcessedEmail[]
  ignoredActivities   IgnoredActivity[]
  priorityActivities  PriorityActivity[]
  senderRules         SenderRule[]
  emailFilterMode     String       @default("ALL") // "ALL" | "ALLOWED_ONLY"
  allowedSenders      AllowedSender[]
  extractedEvents     ExtractedEvent[]
  feedbackSnapshots   FeedbackSnapshot[]
  userFeedbacks       UserFeedback[]
  briefDeliveries     BriefDelivery[]
  aiCallLogs          AICallLog[]

  @@index([householdId])
  @@index([accountStatus])
}

// NextAuth required models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailConnection {
  id                    String           @id @default(uuid())
  userId                String           @unique
  provider              EmailProvider
  emailAddress          String
  accessTokenEncrypted  Bytes
  refreshTokenEncrypted Bytes
  tokenExpiresAt        DateTime
  syncCursor            String?
  lastPolledAt          DateTime?
  status                ConnectionStatus @default(ACTIVE)
  reauthNotifiedAt      DateTime?
  createdAt             DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Parent {
  id           String   @id @default(uuid())
  userId       String
  name         String   @db.VarChar(100)
  relationship String?  @db.VarChar(50)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Child {
  id                      String   @id @default(uuid())
  userId                  String
  nameEncrypted           Bytes    // AES-256-GCM encrypted name
  gradeEncrypted          Bytes    // AES-256-GCM encrypted grade
  classNameEncrypted      Bytes?   // AES-256-GCM encrypted className
  teachersEncrypted       Bytes    // AES-256-GCM encrypted JSON array of teachers
  additionalInfoEncrypted Bytes?   // AES-256-GCM encrypted additionalInfo
  pronouns                String?  // "he" | "she" | "they" — not PII, plain text
  displayOrder            Int      @default(0)
  createdAt               DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedEvents ExtractedEvent[]

  @@index([userId])
}

model IgnoredActivity {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(75)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriorityActivity {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(75)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SenderRule {
  id          String   @id @default(uuid())
  userId      String
  senderEmail String   @db.VarChar(320)
  action      String   // "ALWAYS_FORWARD" | "NEVER_FORWARD"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, senderEmail])
  @@index([userId])
}

model AllowedSender {
  id        String   @id @default(uuid())
  userId    String
  pattern   String   @db.VarChar(320) // "@school.edu" or "teacher@gmail.com"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
}

model ForwardingAddress {
  id             String    @id @default(uuid())
  userId         String
  emailEncrypted Bytes     // AES-256-GCM encrypted email
  emailHash      String    // SHA-256 hex for unique constraint / lookups
  nameEncrypted  Bytes?    // AES-256-GCM encrypted name
  label          String?   @db.VarChar(30)
  isActive       Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailHash])
  @@index([userId])
}

model SystemConfig {
  id                   String   @id @default("singleton")
  isMonitoringEnabled  Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  // Recent Activity
  recentActivityLimit  Int      @default(50)

  // AI Provider
  aiProvider           String?  // "openai" | "anthropic" | "grok" | "gemini"
  aiModel              String?
  aiApiKeyEncrypted    Bytes?   // AES-256-GCM encrypted

  aiVisionModel    String?  // model name for multimodal analysis (same provider/key)

  // Token Cost Estimation (per million tokens, in USD)
  tokenCostInputPerMillion   Float?   // e.g. 2.00 for gpt-4.1
  tokenCostOutputPerMillion  Float?   // e.g. 8.00 for gpt-4.1

  // AI Prompt Instructions (null = use defaults from app.config.defaults.ts)
  aiSystemInstruction          String?
  aiRelevanceInstruction       String?
  aiSummaryInstructionConcise  String?
  aiSummaryInstructionStandard String?
  aiSummaryInstructionDetailed String?
  aiResponseFormatInstruction  String?
  aiNoSendInstruction          String?

  // Worker / Scheduler
  pollIntervalMinutes  Int     @default(15)
  activeHoursStart     Int     @default(6)
  activeHoursEnd       Int     @default(22)
  timezone             String  @default("America/New_York")

  // Branding
  brandName             String  @default("SANE")
  brandTagline          String  @default("School Alerts, Notices & Essentials")
  appUrl                String? // Public-facing base URL for email links; falls back to NEXTAUTH_URL

  // Email Forwarding (Resend)
  resendApiKeyEncrypted  Bytes?  // AES-256-GCM encrypted
  resendFromAddress      String?
  resendWebhookSecret    String? // Resend webhook signing secret
  resendWebhookEnabled   Boolean @default(true)
  emailFooterEnabled     Boolean @default(false)
  emailFooterText        String?

  // Debug & Logging
  debugMode            Boolean @default(false)
  showDebugUI          Boolean @default(false)
  logDir               String  @default("logs")

  // Signup Access Code
  signupCodeEnabled    Boolean @default(false)
  signupCode           String?

  // Data Retention
  dataRetentionDays    Int     @default(30)
  eventRetentionDays   Int     @default(90)
  feedbackSnapshotRetentionDays Int @default(90)
  aiCallLogRetentionDays        Int @default(30)

  // AI Event Extraction
  aiEventExtractionInstruction String? @db.Text

  // AI Brief Summary
  aiBriefSummaryInstruction String? @db.Text

  // Brief Events
  dailyBriefEventDays  Int @default(3)

  // AI Processing
  aiConcurrency        Int @default(10)

  // Alerting
  alertCooldownMinutes  Int @default(30)

  // Broadcast message
  broadcastMessage   String?
  broadcastActive    Boolean  @default(false)
  broadcastEndsAt    DateTime?

  // User Lifecycle
  lifecycleEnforcementEnabled Boolean @default(false)

  // Display Features
  showEmailSummaryInEvents Boolean @default(false)
}

model ProcessedEmail {
  id              String    @id @default(uuid())
  userId          String
  externalMessageId  String
  fromAddress     String
  fromName        String?
  subject         String
  receivedAt      DateTime
  aiDecision      Boolean
  aiRelevant      Boolean  @default(true)
  aiSummary       String?
  aiSubject       String?
  aiProvider      String
  aiModel         String
  aiTokensInput   Int
  aiTokensOutput  Int
  aiLatencyMs     Int
  attachmentCount Int       @default(0)
  imageCount      Int       @default(0)
  forwarded        Boolean   @default(false)
  isManualForward  Boolean   @default(false)
  isBackfill       Boolean   @default(false)
  isDuplicateSlug  Boolean   @default(false)
  skipForwardReason String?
  forwardedAt      DateTime?
  resendMessageId    String?
  deliveryStatus     String?   @default("pending")
  deliveryError      String?
  deliveryUpdatedAt  DateTime?
  processingError String?
  userFeedback       String?   // "correct" | "wrong_forward" | "wrong_skip"
  userFeedbackReason String?
  userFeedbackAt     DateTime?
  aiReasoning     String?
  aiLinks         String?
  topicSlug       String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedEvents ExtractedEvent[]

  @@unique([userId, externalMessageId])
  @@index([userId, createdAt])
  @@index([userId, receivedAt])
  @@index([createdAt])
  @@index([userId, topicSlug, createdAt])
}

model ProcessedEmailDailyStats {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  emailCount      Int      @default(0)
  forwardedCount  Int      @default(0)
  skippedCount    Int      @default(0)
  deliveredCount  Int      @default(0)
  bouncedCount    Int      @default(0)
  tokensInput     Int      @default(0)
  tokensOutput    Int      @default(0)
  attachmentCount Int      @default(0)
  imageCount      Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model ExtractedEvent {
  id               String    @id @default(uuid())
  userId           String
  processedEmailId String?
  title            String    @db.VarChar(300)
  eventDate        DateTime
  endDate          DateTime?
  allDay           Boolean   @default(true)
  location         String?   @db.VarChar(300)
  details          String?
  isTodo           Boolean   @default(false)
  actionable       Boolean   @default(false)
  sourceEmails     String?   /// JSON array: [{subject, fromName, fromAddress}]
  userFeedback       String?
  userFeedbackReason String?
  userFeedbackAt     DateTime?
  isDone           Boolean   @default(false)
  doneAt           DateTime?
  doneByName       String?   @db.VarChar(100)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedEmail  ProcessedEmail? @relation(fields: [processedEmailId], references: [id], onDelete: Cascade)
  children        Child[]

  @@index([userId, eventDate])
  @@index([processedEmailId])
}

model AdminAlert {
  id          String    @id @default(uuid())
  type        String    // "worker_stale" | "ai_error" | "resend_failure" | "gmail_quota"
  severity    String    @default("warning") // "info" | "warning" | "critical"
  title       String
  message     String
  dedupKey    String    // type + context key for dedup (e.g., "ai_error:user123")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, resolvedAt])
  @@index([createdAt])
  @@unique([dedupKey, resolvedAt])
}

model BriefDelivery {
  id                String    @id @default(uuid())
  userId            String
  briefType         String    // "daily" | "weekly"
  status            String    // "sent" | "skipped" | "failed"
  resendMessageId   String?   // Resend API message ID for webhook correlation
  deliveryStatus    String    @default("pending") // "pending" | "delivered" | "bounced" | "complained"
  deliveryUpdatedAt DateTime?
  recipientCount    Int       @default(0)
  error             String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([briefType, createdAt])
  @@index([resendMessageId])
  @@index([userId, createdAt])
}

model FeedbackSnapshot {
  id               String   @id @default(uuid())
  userId           String
  processedEmailId String?
  extractedEventId String?
  feedbackValue    String   // "correct" | "wrong_forward" | "wrong_skip" | "wrong_event"
  encryptedData    Bytes    // AES-256-GCM encrypted JSON blob
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserFeedback {
  id         String           @id @default(uuid())
  userId     String
  category   FeedbackCategory
  subject    String           @db.VarChar(200)
  message    String           @db.Text
  page       String?          @db.VarChar(100)
  appVersion String?          @db.VarChar(50)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AICallLog {
  id                 String    @id @default(uuid())
  userId             String?
  action             String    // "email-analysis", "event-dedup", "event-merge", "daily-brief-summary", "weekly-brief-summary"
  provider           String    // "openai", "anthropic", "gemini", "grok"
  model              String
  success            Boolean
  durationMs         Int
  inputTokens        Int       @default(0)
  outputTokens       Int       @default(0)
  errorType          String?   // "invalid-json", "rate-limit", "timeout", "provider-error"
  errorMessage       String?
  promptEncrypted    Bytes     // AES-256-GCM encrypted prompt text
  responseEncrypted  Bytes?    // AES-256-GCM encrypted response text (null if no response)
  metadata           Json?     // { externalMessageId, processedEmailId, briefType, emailCount, ... }
  createdAt          DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([success, createdAt])
  @@index([createdAt])
}

model DiagnosticRun {
  id            String              @id @default(uuid())
  status        String              @default("running") // "running" | "completed" | "failed"
  findingCount  Int                 @default(0)
  okCount       Int                 @default(0)
  criticalCount Int                 @default(0)
  warningCount  Int                 @default(0)
  infoCount     Int                 @default(0)
  durationMs    Int?
  error         String?
  contextFile   String?             @db.Text
  createdAt     DateTime            @default(now())

  findings      DiagnosticFinding[]

  @@index([createdAt])
}

model DiagnosticFinding {
  id             String         @id @default(uuid())
  runId          String
  severity       String         // "critical" | "warning" | "info"
  category       String         // "brief_gap" | "stale_connection" | "ai_failure_spike" | "bounce_spike" | "pending_brief" | "gmail_quota" | "ai_latency"
  title          String
  description    String         @db.Text
  affectedUsers  Json           // [{id, name, email}]
  metrics        Json           // {key: value}
  detectedAt     DateTime       @default(now())

  run            DiagnosticRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([severity, detectedAt])
}

// ---------------------------------------------------------------------------
// Household: links two parents so they share events, children, and settings
// ---------------------------------------------------------------------------

model Household {
  id            String   @id @default(uuid())
  primaryUserId String   @unique
  createdAt     DateTime @default(now())

  primaryUser   User              @relation("HouseholdPrimary", fields: [primaryUserId], references: [id])
  members       User[]            @relation("HouseholdMember")
  invites       HouseholdInvite[]
}

model HouseholdInvite {
  id          String    @id @default(uuid())
  householdId String
  email       String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([token])
}
